# Production Environment Variables Example
# Copy this file to .env.production.custom and customize for your production environment

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://hms-db:5432/hms_db
SPRING_DATASOURCE_USERNAME=hms_user
SPRING_DATASOURCE_PASSWORD=your-secure-password-here

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Server Configuration
SERVER_PORT=8080
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# MinIO Configuration
MINIO_ENDPOINT=http://hms-minio:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=hms-files

# JWT Configuration (CRITICAL: Change these in production!)
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_ACCESS_TTL=86400
JWT_REFRESH_TTL=604800

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Additional Production Settings
# Uncomment and customize as needed:

# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO
# LOGGING_LEVEL_ORG_HIBERNATE=WARN
# LOGGING_LEVEL_COM_AFYAQUIK_HMS=INFO

# CORS Configuration
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Rate Limiting
# RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Security Headers
# SECURITY_HEADERS_ENABLED=true
