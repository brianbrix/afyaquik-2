# ===========================
# 1️⃣ Build Stage
# ===========================
FROM maven:3.9.8-eclipse-temurin-17 AS build

# Set working directory
WORKDIR /app

# Copy pom.xml first to leverage Docker layer caching
COPY pom.xml .

# Pre-download dependencies (speeds up rebuilds)
RUN mvn dependency:go-offline -B

# Copy the rest of the source code
COPY src ./src

# Package the application (skip tests to speed up)
RUN mvn clean package -DskipTests

# ===========================
# 2️⃣ Runtime Stage
# ===========================
FROM eclipse-temurin:17-jre-jammy AS runtime

# Install curl for healthcheck and diagnostics
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user and app directories
RUN useradd -r -u 1000 -m hms \
    && mkdir -p /app/uploads /app/logs \
    && chown -R hms:hms /app

# Switch to app directory
WORKDIR /app

# Copy the JAR from the build stage
COPY --from=build /app/target/*.jar app.jar
RUN chown hms:hms app.jar

# Switch to non-root user
USER hms

# Expose application port
EXPOSE 8080

# Define healthcheck endpoint
#HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
#  CMD curl -fs http://localhost:8080/actuator/health || exit 1

# Default startup command
ENTRYPOINT ["java", "-jar", "app.jar"]